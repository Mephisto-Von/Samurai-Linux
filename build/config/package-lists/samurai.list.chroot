# Samurai Linux package list (installed inside the live-build chroot).
# Debian 13 "trixie". Keep package names verified against trixie.

# Desktop environment
kde-standard
sddm
kde-config-sddm
plasma-desktop
plasma-workspace
plasma-nm
plasma-pa
plasma-browser-integration
konsole
dolphin
ark
kate
gwenview
okular
kde-spectacle
xserver-xorg
xwayland
# Debian splits KWin by session type: plasma-workspace ships both session
# entries and startplasma-x11, but the X11 compositor itself is the kwin-x11
# package. Without it the login screen offers "Plasma (X11)", starting it gets a
# session with no window manager, and the Wayland-crash advice in
# samurai/docs/installation.md points at a session that cannot run
# (run 41993508779 restarted SDDM into plasmax11 and found no kwin_x11).
kwin-x11
pipewire
pipewire-pulse
wireplumber
alsa-utils
xdg-user-dirs
xdg-utils
bluedevil
firefox-esr
fonts-noto-cjk
fonts-noto-color-emoji
fonts-dejavu

# Installer (Calamares running from the live session)
calamares
calamares-settings-debian
os-prober
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
efibootmgr
dosfstools
mtools
# unpackfs shells out to unsquashfs; do not rely on a recommends here.
squashfs-tools
# Filesystem tools for the optional manual-partitioning choices.
btrfs-progs
xfsprogs
f2fs-tools
ntfs-3g
os-prober
x11-xserver-utils

# Live system (required for a bootable live image)
live-boot
live-config
live-config-systemd
live-tools
user-setup
initramfs-tools
linux-image-amd64

# System and developer basics
pciutils
libsecret-tools
ca-certificates
curl
wget
git
openssh-client
sudo
vim
python3
python3-venv
build-essential
cmake
ninja-build
nftables
apparmor
apparmor-profiles
unattended-upgrades

# OpenGL / Vulkan providers. kde-standard pulls Qt and Plasma but no DRI driver,
# and without one KWin cannot create a context ("egl: failed to create dri2
# screen") - the cost of that omission was a desktop phase that never started.
libgl1
libgl1-mesa-dri
libglx-mesa0
libegl1
libegl-mesa0
mesa-utils
mesa-vulkan-drivers

# Gaming runtime (Steam is installed after first boot with samurai-gaming)
gamemode
mangohud
