#!/bin/sh
# Apply the Samurai Linux security defaults inside the chroot.
#
# Three things happen here that includes.chroot alone cannot do:
#
#   1. fix the ownership and modes git cannot carry (sudo and nft both refuse to
#      read a file that is group- or world-writable, or not root-owned, and fail
#      *silently* - the policy would be present and dead);
#   2. prove the Debian security pocket is really in the installed system's
#      source list, because every automatic-update claim below depends on it;
#   3. enable the units those files drive, since a configured service that is
#      not started is exactly the "enabled because installed" mistake the
#      project requirements forbid.
#
# install-test.py re-checks each of these on the installed system.
set -eu

fail() {
	echo "security hook: $*" >&2
	exit 1
}

# --- permissions the git index cannot express -------------------------------

for file in /etc/nftables.conf /etc/apt/preferences.d/99samurai \
	/etc/apt/apt.conf.d/20samurai-security \
	/etc/apt/sources.list.d/samurai-security.list \
	/etc/systemd/journald.conf.d/99samurai.conf; do
	[ -f "$file" ] || fail "$file is missing from includes.chroot"
	chown root:root "$file"
	chmod 0644 "$file"
done

sudoers=/etc/sudoers.d/90samurai
[ -f "$sudoers" ] || fail "$sudoers is missing from includes.chroot"
chown root:root "$sudoers"
chmod 0440 "$sudoers"
command -v visudo >/dev/null 2>&1 || fail "visudo is not in the image to validate sudoers"
visudo -c -f "$sudoers" >/dev/null 2>&1 || fail "$sudoers is not valid sudoers syntax"
visudo -c >/dev/null 2>&1 || fail "the merged sudoers configuration does not validate"

# /usr/local/bin is filled from the repository tree, whose owner is whoever ran
# the checkout - uid 1001 in a hosted build, which is no user at all inside the
# chroot. Writing to a directory you own does not need the group bit, so that uid
# could replace a samurai-* script that users run through sudo. Owning the
# directory and its tools is what makes the shipped CLIs root-controlled.
chown -R root:root /usr/local/bin
chmod 0755 /usr/local/bin
for script in /usr/local/bin/samurai-*; do
	[ -f "$script" ] || continue
	chmod 0755 "$script"
done

# Exception directory for the firewall. Empty by design; see nftables.conf.
mkdir -p /etc/nftables.d
chown root:root /etc/nftables.d
chmod 0755 /etc/nftables.d

# --- a reachable, signed security archive -----------------------------------

# The pocket comes from /etc/apt/sources.list.d/samurai-security.list, which
# includes.chroot placed there above. What is proved here is that it resolves and
# authenticates; whether it survives into the image is checked by
# build/verify-iso.sh against the squashfs, because live-build rewrites
# /etc/apt/sources.list around the hooks and its own security handling is what
# failed in runs 41447034423 and 41452920694.
apt-get update -o APT::Acquire::Retries=3 \
	|| fail "apt could not update from the configured archives (an unsigned or unreachable one is fatal here)"
apt-cache policy | grep -q 'n=trixie-security' \
	|| fail "the build has no Debian security archive to fetch security updates from"

# --- the automatic updater must be pointed at that archive by name ------------

# unattended-upgrades matches upgrades against Allowed-Origins as
# "Origin:Suite", and the "${distro_id}" it would substitute is this project's
# own lsb-release value, which says Samurai and matches no Debian archive. So
# 20samurai-security names the Origin literally, and the only honest way to
# check that literal is to read it back from the Release file apt just
# authenticated above. If Debian changes the field, the build fails here instead
# of shipping a machine that never applies a security update.
security_release=$(find /var/lib/apt/lists -maxdepth 1 \
	-name '*trixie-security*Release' -print 2>/dev/null | sort | head -n 1)
[ -n "$security_release" ] || fail "apt fetched no Release file for trixie-security"
security_origin=$(awk -F': *' '/^Origin: /{ print $2; exit }' "$security_release")
[ -n "$security_origin" ] || fail "$security_release carries no Origin field"
grep -q "\"$security_origin:trixie-security\"" /etc/apt/apt.conf.d/20samurai-security \
	|| fail "the security archive's Origin is '$security_origin', but 20samurai-security allows no such origin: unattended upgrades would match nothing"
apt-config dump Unattended-Upgrade::Allowed-Origins 2>&1 | grep -q 'security' \
	|| fail "apt reads no Allowed-Origins entry naming the security archive"

# --- put the security updates in before the root filesystem is packed -------
#
# Doing this here is not a nicety. live-build's binary stage runs its own apt
# upgrade over the chroot *after* binary_rootfs has already written the
# squashfs, and binary_linux-image then copies the newest /boot/vmlinuz into
# /live. Run 41545976827 shipped exactly that split: the ISO booted
# 6.12.115+deb13.1 while /lib/modules in the image held only 6.12.107+deb13, so
# autoload found nothing (modprobe: "Module nf_tables not found in directory
# /lib/modules/6.12.115+deb13.1-amd64"), nft failed with "Unable to initialize
# Netlink socket: Protocol not supported" and nftables.service exited 3. The
# same packages are upgraded at the same point in the run either way; the
# difference is whether the kernel the image boots has its modules in it.
apt-get -y dist-upgrade || fail "security updates could not be installed into the image"

# A kernel that cannot load netfilter cannot run the default-deny ruleset, so
# the pairing is asserted off the chroot that becomes the squashfs.
kernels=0
for image in /boot/vmlinuz-*; do
	[ -f "$image" ] || continue
	kernels=$((kernels + 1))
	version=${image##*/vmlinuz-}
	[ -d "/lib/modules/$version" ] \
		|| fail "/boot has vmlinuz-$version but /lib/modules/$version is absent: the image would boot a kernel with no loadable modules"
	nftables_module=""
	for module in "/lib/modules/$version/kernel/net/netfilter/"nf_tables.ko*; do
		if [ -f "$module" ]; then
			nftables_module=$module
		fi
	done
	[ -n "$nftables_module" ] \
		|| fail "vmlinuz-$version ships no nf_tables module, so the shipped ruleset cannot load"
done
[ "$kernels" -gt 0 ] || fail "the image has no /boot/vmlinuz-* at all"

# --- the units that make the configuration live -----------------------------

for unit in nftables.service apparmor.service apt-daily.timer apt-daily-upgrade.timer; do
	systemctl enable --no-reload "$unit" >/dev/null 2>&1 \
		|| fail "$unit could not be enabled (is the package that ships it installed?)"
	state=$(systemctl is-enabled "$unit" 2>&1) || true
	[ "$state" = enabled ] || fail "$unit is $state, expected enabled"
done
