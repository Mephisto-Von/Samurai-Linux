#!/bin/sh
# live-build configuration for Samurai Linux.
# Invoked by `lb build`, or directly with: bash auto/config
set -eu

# live-build recommends starting from a clean saved config. Keep our
# package-lists, hooks, and includes.chroot; remove only generated state.
rm -rf config/binary config/bootstrap config/chroot config/common config/source

lb config noauto \
    --distribution trixie \
    --architecture amd64 \
    --binary-image iso-hybrid \
    --archive-areas "main contrib non-free-firmware" \
    --debian-installer none \
    --firmware-chroot true \
    --bootappend-live "boot=live components username=samurai hostname=samurai quiet splash console=tty0 console=ttyS0,115200n8 systemd.show_status=1" \
    --iso-application "Samurai Linux" \
    --iso-publisher "Samurai Linux Project" \
    --iso-volume "SAMURAI_LINUX" \
    --apt-indices false \
    --security false \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/"

# The Debian security pocket is not requested through live-build at all: it
# ships as config/includes.chroot/etc/apt/sources.list.d/samurai-security.list,
# and --security false keeps live-build from writing its own entry beside it.
#
# Two runs proved why the options cannot be trusted to do this. live-build
# replaces /etc/apt/sources.list for the build (scripts/build/chroot_archives
# "install"), packs the rootfs from that tree, and only afterwards rewrites the
# file with the configuration meant for the final system - so what the squashfs
# inherits is whatever the build pass left, which is not what the manual says the
# image will contain. Runs 41447034423 and 41452920694 both built images whose
# shipped sources listed no security archive even with --mirror-chroot-security
# and --security true set, and verify-iso.sh caught both. A file under
# includes.chroot is copied into the chroot once and never revisited, which is
# the same reason etc/nftables.conf and etc/apt/apt.conf.d/20samurai-security can
# be relied on. build/verify-iso.sh reads the squashfs and fails the build if the
# image would ship no security archive.
